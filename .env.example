# Copy to .env. Nothing in this file is secret except LLM_API_KEY.

# Postgres (docker compose sets this for you)
DATABASE_URL=postgresql://ops:ops@localhost:5432/ops

# LLM provider: scripted | scripted-hijacked | openai | gemini | groq | openai-compatible
LLM_PROVIDER=scripted
LLM_MODEL=scripted-v1
LLM_API_KEY=
# Only for openai-compatible (vLLM, Ollama, LiteLLM, OpenRouter, ...)
LLM_BASE_URL=
LLM_TEMPERATURE=0
# USD per 1M tokens for cost tracking; set from your provider's current price list.
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0

# Empty = spawn MCP servers as stdio subprocesses
MCP_CRM_URL=
MCP_TICKETING_URL=

# Policy
REFUND_APPROVAL_THRESHOLD_CENTS=10000
REFUND_HARD_CAP_CENTS=100000
SUPPORT_EMAIL=support@acme-shop.example

# Budgets per run
MAX_LLM_CALLS=30
MAX_TOOL_CALLS=20
MAX_TOTAL_TOKENS=120000
MAX_COST_USD=0.25

# Approval console: if set, decisions need this value in the X-Reviewer-Token header
REVIEWER_TOKEN=

# Tracing (Jaeger in docker compose listens on 4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
